# Обязательно: токен бота от @BotFather.
# При запуске через start.bat / start.sh бот спросит его сам — этот файл можно не трогать.
BOT_TOKEN=

# ---- Всё ниже необязательно ----

# Ваш Telegram ID. Если не указан, владельцем станет первый, кто нажмёт Start в боте.
OWNER_ID=

# Ключи OLX API. Обычно их вводят прямо в боте (⚙️ Настройки), здесь — только если так удобнее.
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
# Должен совпадать с адресом, указанным при регистрации приложения на developer.olx.ua
OLX_REDIRECT_URI=https://example.com/

# Сайт OLX: www.olx.ua (по умолчанию), www.olx.pl, www.olx.ro, www.olx.pt, www.olx.bg, www.olx.kz, www.olx.uz
OLX_DOMAIN=www.olx.ua

# Как часто проверять новые сообщения, секунд (минимум 5)
POLL_INTERVAL=10
